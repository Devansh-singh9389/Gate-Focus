<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:animateLayoutChanges="true"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Subject Header (Clickable to expand/collapse) -->
    <LinearLayout
        android:id="@+id/subject_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/badge_subject_code"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge_primary"
            android:gravity="center"
            android:textColor="@color/primary_indigo_light"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_subject_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_subject_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_subject_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_emerald_text"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_subject_topics_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp" />

            <ImageView
                android:id="@+id/icon_subject_expand"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Material 3 LinearProgressIndicator for subject -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_subject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:max="100"
        app:indicatorColor="@color/accent_emerald"
        app:trackColor="#1E2A44"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp" />

    <!-- Container for collapsible topics -->
    <LinearLayout
        android:id="@+id/topics_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>
