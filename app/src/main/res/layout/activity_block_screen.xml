<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Shield Icon in Rose Circle -->
    <LinearLayout
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_badge_warning"
        android:gravity="center">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_shield"
            app:tint="@color/accent_amber" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:letterSpacing="0.04"
        android:text="GATE Goal Protected"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_blocked_app_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Study mode is active. This app is blocked for this session."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Motivation Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:text="GATE CSE MOTIVATION"
            android:textColor="@color/primary_indigo_light"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="&quot;Every moment of disciplined study compounds into rank-defining clarity. Breathe, refocus, and conquer the syllabus.&quot;"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Return Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_back_to_focus"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/primary_indigo"
        android:letterSpacing="0.04"
        android:text="Return to GATE FOCUS"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_arrow_back"
        app:iconGravity="textStart" />
</LinearLayout>
