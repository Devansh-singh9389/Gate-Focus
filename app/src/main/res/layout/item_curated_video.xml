<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_secondary"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_library"
        app:tint="@color/primary_indigo_light" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_video_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Operating Systems — Process Scheduling"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_video_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="ID: dQw4w9WgXcQ"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Watch Button with Pure White Text -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_watch_video"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:backgroundTint="@color/btn_primary_bg"
        android:paddingHorizontal="14dp"
        android:text="Watch"
        android:textColor="@color/btn_text_pure_white"
        android:textSize="13sp"
        android:textStyle="bold"
        app:cornerRadius="10dp"
        app:icon="@drawable/ic_play"
        app:iconSize="14dp"
        app:iconTint="@color/btn_text_pure_white" />

    <!-- Delete Button -->
    <ImageView
        android:id="@+id/btn_delete_video"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="9dp"
        android:src="@drawable/ic_delete"
        app:tint="@color/text_secondary" />
</LinearLayout>
