<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="108dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Add Video Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/primary_indigo_light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:letterSpacing="0.06"
                    android:text="ADD GATE LECTURE"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Add YouTube lecture IDs to stream directly via privacy embed without recommendation feeds."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Lecture title (e.g. OS — Virtual Memory)"
                app:boxStrokeColor="@color/primary_indigo"
                app:hintTextColor="@color/primary_indigo_light">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_video_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="11-character YouTube ID (e.g. jNQXAC9IVRw)"
                app:boxStrokeColor="@color/primary_indigo"
                app:hintTextColor="@color/primary_indigo_light">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_video_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- High Contrast Add Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_video"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/btn_primary_bg"
                android:elevation="3dp"
                android:letterSpacing="0.04"
                android:text="Add to Library"
                android:textColor="@color/btn_text_pure_white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconTint="@color/btn_text_pure_white" />
        </LinearLayout>

        <!-- Saved Lectures Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="SAVED LECTURES"
                android:textColor="@color/primary_indigo_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_lectures_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 videos"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/layout_empty_library"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_library"
                app:tint="@color/primary_indigo_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Your library is empty"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Add YouTube lecture IDs above, or load recommended starter lectures for GATE CS."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Starter Pack Button with High Contrast -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_load_starter"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/btn_secondary_bg"
                android:text="@string/btn_load_starter_lectures"
                android:textColor="@color/btn_text_pure_white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_sparkles"
                app:iconGravity="textStart"
                app:iconTint="@color/accent_amber"
                app:strokeColor="@color/btn_secondary_border"
                app:strokeWidth="1.5dp" />
        </LinearLayout>

        <!-- Dynamic Lecture Cards Container -->
        <LinearLayout
            android:id="@+id/layout_videos_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
